# Copy to .env. Replace both passwords with different random, URL-safe values.
# Keep these fixed role/database names unless you also update init scripts.
POSTGRES_DB=equiptrack
POSTGRES_USER=equiptrack_owner
POSTGRES_PASSWORD=replace-with-random-owner-password
POSTGRES_APP_PASSWORD=replace-with-different-random-app-password
# WSL / Linux container variables. Database is NOT published to the LAN.
DATABASE_URL=postgresql+psycopg://equiptrack_app:replace-with-different-random-app-password@db:5432/equiptrack
MIGRATION_DATABASE_URL=postgresql+psycopg://equiptrack_owner:replace-with-random-owner-password@db:5432/equiptrack
HTTPS_PORT=8443
# Exact browser origin, including port. Update both when changing host or port.
APP_ORIGIN=https://localhost:8443
# Use 0.0.0.0 only for supervised LAN acceptance after authentication is built.
BIND_ADDRESS=127.0.0.1
APP_ENV=development
